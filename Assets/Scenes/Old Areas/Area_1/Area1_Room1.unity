  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7f74bc9e95c05604cbc630d06364cc06, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  timeline1: {fileID: 11400000, guid: 720d4c8e451760948ad5aa24e9b4fd98, type: 2}
  timeline2: {fileID: 11400000, guid: 50467b45f91c554498b75c5152964fdd, type: 2}
  timeline3: {fileID: 11400000, guid: 8b44ac63bf19bfa4ca6b5e5bc0572ac1, type: 2}
  timeline3_5: {fileID: 11400000, guid: d2d9581490c2eee4c956885acd082ba1, type: 2}
  timeline4: {fileID: 11400000, guid: 8fe71f0afba0f4747a5fefa669d3a226, type: 2}
  timeline5: {fileID: 11400000, guid: 04cf23c0554a08e42bb8aba63fb4cdd6, type: 2}
  timeline6: {fileID: 11400000, guid: 164429762194d6b4ea3222005c18de23, type: 2}
  timeline7: {fileID: 11400000, guid: dab4cc9806278d8429a9fe20784fcd34, type: 2}
  dialogue1:
  - name: Ibaraki Doji
    sentence: Well, well... What do we have here?
  - name: Ibaraki Doji
    sentence: What are you worms doing in Lord Shuten Doji's territory?
  - name: Urabe
    sentence: What did you say?!
  dialogue2:
  - name: Raiko
    sentence: You are holding Sayome Fujiwara, the daughter of our master!
  - name: Raiko
    sentence: We demand her release now, before blood is shed!
  - name: Ibaraki Doji
    sentence: 'Ha ha ha ha!

'
  - name: Ibaraki Doji
    sentence: Blood, you say?
  - name: Ibaraki Doji
    sentence: You humans disgust me! You act as if you own the world just because
      you have the numbers, but you are nothing more than pathetic creatures!
  dialogue2_5:
  - name: Ibaraki Doji
    sentence: Huh?
  - name: Ibaraki Doji
    sentence: What is this?
  - name: Ibaraki Doji
    sentence: A human girl?!
  dialogue3:
  - name: Usui
    sentence: '!!!!!'
  - name: Ibaraki Doji
    sentence: I have a better offer for you. Hand over the girl, and your blood will
      not be shed.
  - name: Ibaraki Doji
    sentence: What do you say? A single woman in exchange for your lives! Isn't that
      a grand bargain?
  dialogue4:
  - name: Raiko
    sentence: "We came here for Sayome Fujiwara. We\u2019re not leaving without her."
  - name: Ibaraki Doji
    sentence: Fool!
  - name: Ibaraki Doji
    sentence: "If that\u2019s your choice, then have it your way, human!"
  dialogue4_5:
  - name: Oni
    sentence: Die!
  dialogue5:
  - name: Raiko
    sentence: "If you prefer it this way, we\u2019ll carve our own path if we have
      to."
  dialogue6:
  - name: Ibaraki Doji
    sentence: Cursed human...
  - name: Ibaraki Doji
    sentence: If you're so brave, why don't you try your luck without your friends
      hiding behind you?
  dialogue7:
  - name: Kintaro
    sentence: Raiko!
  audioSource: {fileID: 937018795}
  tensionMusic: {fileID: 8300000, guid: c231514fcf6c3754db922bc35f66a81c, type: 3}
  ambushMusic: {fileID: 8300000, guid: de83db67b38df3f438265ffe99c44d47, type: 3}
