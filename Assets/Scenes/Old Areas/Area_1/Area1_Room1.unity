--- !u!114 &359330524
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 359330521}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2429aebe95fa3c14cb0cc5b9d0aaf977, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  timeline1: {fileID: 11400000, guid: 2c2356b7cd52b1349a14aaa0515c5588, type: 2}
  timeline2: {fileID: 11400000, guid: 6eac565e0526c094999061d17936743c, type: 2}
  dialogue1:
  - name: Usui
    sentence: According to our informants, this is their hideout.
  - name: Urabe
    sentence: Ha ha ha! Finally! These cursed yokai will regret the day they ever
      crossed paths with the great Urabe!
  - name: Kintaro
    sentence: Great Urabe? What a joke...
  - name: Urabe
    sentence: Boys your size should watch their tongues.
  - name: Raiko
    sentence: Silence! Do not forget our purpose here.
  - name: Raiko
    sentence: Sayome is in danger. We have to rescue her at any cost.
  - name: Watanabe
    sentence: Raiko, do you know what Shuten Doji is planning for Lord Fujiwara's
      daughter?
  - name: Raiko
    sentence: No...
  - name: Raiko
    sentence: So keep your eyes wide open. The enemy might already be waiting for
      us.
  - name: Kintaro
    sentence: Leave it to us!
  cutscene_Raiko: {fileID: 1864424978}
  raiko: {fileID: 325114121}
  cutsceneCameraPosition: {fileID: 1466346912}
  gameCamera: {fileID: 325114120}
